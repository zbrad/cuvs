# tuned/repo.env -- cuvs-specific settings for tuned builds. Sourced by tuned/env.sh after the
# shared device and toolkit definitions (tuned/common-data, from zbrad/tuned-common).
#
# This file may only ADD repo-specific settings. Changing any shared key
# (GPU_TUNED_*, CUDA_*, TOOLKIT_*) is a loud error from env.sh.
#
# Plain assignment on purpose: this file is sourced inside a function, where
# `declare` would make the variable local and lose it.

# BUILD_MG_ALGOS is OFF for GB10 only (single-GPU edge device -- no multi-GPU algorithms to
# build); ON for rtx40/rtx50. CUVS_DEVICE_LABEL is the short name used in build banners.
case "${GPU_TUNED_VARIANT}" in
    gb10)  CUVS_BUILD_MG_ALGOS="OFF"; CUVS_DEVICE_LABEL="GB10" ;;
    rtx40) CUVS_BUILD_MG_ALGOS="ON";  CUVS_DEVICE_LABEL="RTX 40" ;;
    rtx50) CUVS_BUILD_MG_ALGOS="ON";  CUVS_DEVICE_LABEL="RTX 50" ;;
    *) echo "ERROR: repo.env: no cuvs settings for variant '${GPU_TUNED_VARIANT}'" >&2; return 1 ;;
esac
